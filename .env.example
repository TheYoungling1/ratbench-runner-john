# Copy this file to `.env` and fill in your key(s). NEVER commit .env (it's gitignored).
#
# OpenRouter key — used by the dockeragent varieties and baselines (routed via LiteLLM/OpenRouter):
OPENROUTER_API_KEY=
#
# OpenAI key — only if a variety/model routes through OpenAI directly:
OPENAI_API_KEY=
#
# DeepSeek key — used by `sweagent_repo2run` (via litellm) and `setupx` (raw OpenAI-compatible
# HTTP), which route through DeepSeek's own API rather than OpenRouter:
DEEPSEEK_API_KEY=
#
# Aliyun Bailian key (ALIYUN - Swe-Maintain 2). Used directly (OpenAI-compatible base) by nothing
# yet; used by the `claudecode-bailian` variety via its Anthropic-compatible skin — see that
# variety's comment in varieties.toml. To run it, export at runtime (not here, so it doesn't
# collide with the OpenRouter-routed claudecode-dockerfile variety):
#   ANTHROPIC_BASE_URL=https://ws-yoer0farw5x7zgc1.cn-beijing.maas.aliyuncs.com/apps/anthropic
#   ANTHROPIC_API_KEY=<BAILIAN_API_KEY below>
BAILIAN_API_KEY=
BAILIAN_API_BASE=https://ws-yoer0farw5x7zgc1.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_DASHSCOPE_BASE=https://ws-yoer0farw5x7zgc1.cn-beijing.maas.aliyuncs.com/api/v1
#
# `setupx` XPU-on arm only — leave all five unset to run the arm XPU-off (no embeddings, no
# postgres, DEEPSEEK_API_KEY + docker is enough). DeepSeek serves no /embeddings route, so
# EMBEDDING_API_KEY must point somewhere else; the producer refuses to start with SETUPX_DB_DSN set
# and any of the three EMBEDDING_* unset, because retrieval would 404 silently and leave an arm
# that reports as XPU-on while retrieving nothing. EMBEDDING_DIM must match the model AND the
# dimension the store was imported at (1536 = text-embedding-3-small). See README, "SetupX setup".
SETUPX_DB_DSN=postgresql://postgres:setupx@localhost:5433/xpu_run
EMBEDDING_API_KEY=                                 # same OpenRouter key the sweagent arms use
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small      # 1536 dims, $0.02/M
EMBEDDING_DIM=1536
