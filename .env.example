# Copy this file to `.env` and fill it in. NEVER commit .env (it's gitignored).

# One OpenAI-compatible endpoint for every arm. LLM_BASE_URL defaults to OpenRouter.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional: one model for every arm, spelled the way this provider names it. Leave empty to use
# each arm's pinned model from varieties.toml (OpenRouter names). `--llm` overrides both.
LLM_MODEL=

# SetupX XPU store (tools/provision_setupx.sh creates it). Embeddings use the key and endpoint
# above; on a provider other than OpenRouter, also set the embedding model and its dimension.
SETUPX_DB_DSN=postgresql://postgres:setupx@localhost:5433/xpu_run
# EMBEDDING_MODEL=
# EMBEDDING_DIM=

# Claude Code arm only. The CLI speaks Anthropic's format, so it needs the provider's
# Anthropic-compatible endpoint — here the local thinking proxy in front of OpenRouter
# (see README, "Adding Claude Code"). It authenticates with LLM_API_KEY.
ANTHROPIC_BASE_URL=http://host.docker.internal:8931/api
PROXY_UPSTREAM_HOST=openrouter.ai
