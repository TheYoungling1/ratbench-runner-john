+    @property
+    def _ckpt_repo(self) -> str:
+        """Per-run image repository for checkpoints.
+
+        The original name is a single global (`setup_agent_checkpoint`), so two concurrent runs
+        overwrite each other's `initial_clone` / `step_<n>_pre_xpu` tags and `_cleanup_stale_
+        checkpoints` deletes the other run's snapshots outright — a rollback then restores the
+        wrong repo's container, or dies on ImageNotFound. Namespacing by SETUPX_CKPT_NS (the
+        caller's token, so it can sweep leftovers) or the pid makes runs independent.
+
+        A property, not an __init__ attribute: _create_with_work_dir() builds instances via
+        __new__ and never runs __init__.
+        """
+        return "setup_agent_checkpoint_" + os.environ.get("SETUPX_CKPT_NS", str(os.getpid()))
+
