+# ── Per-run LLM call budget (bench) ──────────────────────────────────────────────────────────
+#
+# SetupX ships no call limit: `--max-steps` bounds AGENT STEPS, and one step can cost many
+# completions (a VERIFY step runs the verifier's whole ReAct sub-loop; phase 2 adds the prosecutor
+# and the judge). For a benchmark arm whose budget must be comparable with SWE-agent's
+# per_instance_call_limit, the unit has to be calls. Every completion funnels through
+# LLMClientBase.chat, so this is the one place to count. Embeddings use the OpenAI SDK directly
+# and are correctly NOT counted.
+
+
+class LLMCallLimit(BaseException):
+    """Raised when a run exhausts SETUPX_MAX_LLM_CALLS.
+
+    BaseException, not Exception: the retriever, verifier, prosecutor and judge all wrap their
+    chat() calls in `except Exception`, which would swallow the limit and let the run keep
+    spending past its budget. Same reasoning as main.py's Phase1Timeout.
+    """
+
+
+_llm_calls = 0
+
+
+def llm_calls_used() -> int:
+    """Completions issued so far in this process (one process == one repo)."""
+    return _llm_calls
+
+
+def _count_llm_call() -> None:
+    """Count one completion and enforce the budget. 0 / unset / malformed => unlimited (stock)."""
+    global _llm_calls
+    _llm_calls += 1
+    try:
+        limit = int(os.environ.get("SETUPX_MAX_LLM_CALLS", "0") or 0)
+    except ValueError:
+        limit = 0
+    if limit > 0 and _llm_calls > limit:
+        raise LLMCallLimit(f"LLM call budget exhausted ({limit} calls)")
+
+
+# ── Per-run token usage (bench) ──────────────────────────────────────────────────────────────
+#
+# Stock chat() reads `data["choices"]` and throws the rest of the response away, so every run
+# reports null tokens and no cost can ever be computed for the arm. The `usage` block sits right
+# there in the same payload; accumulate it here, next to the call counter, for the same reason —
+# every completion funnels through these two chat() implementations.
+
+_llm_usage = {"prompt_tokens": 0, "completion_tokens": 0,
+              # DeepSeek's native cache split. The documented fields, and they agree exactly with
+              # prompt_tokens_details.cached_tokens, so that nested form is not read as a fallback.
+              "prompt_cache_hit_tokens": 0, "prompt_cache_miss_tokens": 0}
+
+
+def llm_usage_used() -> dict:
+    """Tokens billed so far in this process (one process == one repo). A copy, not the live dict."""
+    return dict(_llm_usage)
+
+
+def _record_usage(usage: Any) -> None:
+    """Accumulate one response's `usage` block. NEVER raises.
+
+    This is telemetry wrapped around a paid-for run: a provider that omits the block, renames a
+    field, or returns a string where an int belongs must cost a token count, not the repo. Every
+    value is coerced independently, and whatever will not coerce is skipped.
+    """
+    if not isinstance(usage, dict):
+        return
+    for key in _llm_usage:
+        try:
+            _llm_usage[key] += int(usage.get(key) or 0)
+        except (TypeError, ValueError):
+            continue
+
