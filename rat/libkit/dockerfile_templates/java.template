FROM {BASE_IMAGE_WITH_VERSION}

RUN apt-get update && \
    apt-get install -y maven gradle && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y python3 python3-pip git curl wget && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python || true

RUN rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED 2>/dev/null || true

RUN mkdir -p ~/.pip && echo "[global]" > ~/.pip/pip.conf && echo "index-url = https://mirrors.aliyun.com/pypi/simple/" >> ~/.pip/pip.conf && echo "trusted-host = mirrors.aliyun.com" >> ~/.pip/pip.conf

RUN pip install --no-cache-dir openai

RUN git config --global --add safe.directory /repo

WORKDIR /repo
